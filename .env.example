# Convex (client)
NEXT_PUBLIC_CONVEX_URL=

# Convex deploy key used by CI / Vercel builds (npx convex deploy)
CONVEX_DEPLOY_KEY=

# Optional test-only dev auth (Next.js; never enable in production)
# KITE_DEV_AUTH=1
# NEXT_PUBLIC_KITE_DEV_AUTH=1
# KITE_DEV_AUTH_PRIVATE_KEY=<base64-encoded RSA PEM private key>
# KITE_DEV_AUTH_ISSUER=http://localhost:3000/api/dev-auth
# Run `npx tsx scripts/configure-dev-auth.mts` to sync the issuer and PUBLIC
# KITE_DEV_AUTH_JWKS to the selected Convex dev deployment, then push the config.
# Do not put the private signing key on Convex.

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex environment variables (set via `npx convex env set` on the deployment)
# Issuer domain of Clerk JWTs, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# 32-byte base64 AES-256-GCM key for accountSecrets payloads
CREDENTIALS_ENCRYPTION_KEY=
# Experiential Labs Jev API key
EXPERIENTIAL_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
