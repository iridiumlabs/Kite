# Convex (client)
NEXT_PUBLIC_CONVEX_URL=

# Convex deploy key used by CI / Vercel builds (npx convex deploy)
CONVEX_DEPLOY_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex environment variables (set via `npx convex env set` on the deployment)
# Issuer domain of Clerk JWTs, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
# 32-byte base64 AES-256-GCM key for accountSecrets payloads
CREDENTIALS_ENCRYPTION_KEY=
# Experiential Labs Jev API key
EXPERIENTIAL_API_KEY=
# Optional, defaults to jev-latest
JEV_MODEL=
